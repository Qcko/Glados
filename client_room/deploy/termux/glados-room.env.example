# GLaDOS room-client deploy env (Termux). Copy this to ~/.config/glados-room/env
# on the phone and fill in your paths; the service's `run` script sources it.
#
#   mkdir -p ~/.config/glados-room
#   cp client_room/deploy/termux/glados-room.env.example ~/.config/glados-room/env
#   $EDITOR ~/.config/glados-room/env
#
# The real env file is machine-specific and is gitignored — never commit it.
# Every value here has a sane Termux default in `run`, so an empty/absent file
# still works if your layout matches the defaults below.

# Directory the client was installed into (contains client_room/, and the
# operator-provided client_room/config.room.toml). Default: $HOME/glados
# GLADOS_ROOM_DIR="$HOME/glados"

# Python interpreter to run the client with. Use a venv's python here if you
# installed the client into one. Default: python (Termux's system python)
# GLADOS_ROOM_PYTHON="$HOME/glados/.venv/bin/python"
