# The pre-commit hook is run through sh; CRLF would break its `#!` shebang on
# Windows checkouts. Force LF regardless of core.autocrlf.
.githooks/pre-commit text eol=lf

# Termux/Android deploy scripts are exec'd by runit/Termux:Boot through sh; a
# CRLF in the `#!` shebang breaks them on the phone. Force LF regardless of the
# host's core.autocrlf (the `run`/`log/run` files have no extension).
client_room/deploy/termux/boot/start-glados-room.sh    text eol=lf
client_room/deploy/termux/service/glados-pulse/run     text eol=lf
client_room/deploy/termux/service/glados-pulse/log/run text eol=lf
client_room/deploy/termux/service/glados-room/run      text eol=lf
client_room/deploy/termux/service/glados-room/log/run  text eol=lf
client_room/deploy/termux/selftest.sh                  text eol=lf
client_room/deploy/termux/make-phone-bundle.sh         text eol=lf
client_room/deploy/termux/deps.sh                      text eol=lf
client_room/deploy/termux/dispatch.sh                  text eol=lf
client_room/deploy/termux/enroll.sh                    text eol=lf
client_room/deploy/termux/provision.sh                 text eol=lf

# Server-side TLS cert generator, run through sh on the dev box / server.
scripts/gen-tls-cert.sh                                text eol=lf

# The Modelfile body IS the chat template Ollama bakes into the model, so a
# CRLF here puts a stray carriage return into every rendered prompt. Force LF
# regardless of the host's core.autocrlf.
configs/ministral3-8b-instruct.Modelfile               text eol=lf
